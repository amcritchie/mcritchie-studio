#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/fast-check — the G1 FAST cert: run the tests the branch diff maps to plus
# the curated core spine, and rubocop on the CHANGED files only, then record
# fingerprint-bound "[fast-cert@<tree-hash>]" evidence on the task.
#
# Why (the 90/10 rethink): GitHub CI already runs the FULL suite + test:system on
# every PR push — so a ~6-minute local `bin/full-suite-check` before handoff
# bought EARLINESS, not coverage. This is the earliness at ~1/6 the cost: catch
# the obvious break in about a minute and let CI be the full net. bin/dor-check
# accepts FRESH fast-cert evidence as the suite gate alongside a green GitHub CI
# — and, submit-side, PROVISIONALLY while the open PR's CI is still pending (no
# CI wait at submit; review's gate-zero enforces the settled green). Full-suite
# evidence and the "[full-suite-bypass] <reason>" hatch keep working unchanged.
# bin/full-suite-check itself is UNTOUCHED — it remains release verification and
# the heavyweight cert.
#
# Test selection (bin/lib/fast_cert.rb, unit-tested there):
#   mapped : each changed file → its test by path convention (app/models/x.rb →
#            test/models/x_test.rb, views → their controller test, bin/tool →
#            test/lib/tool_test.rb, a changed *_test.rb runs itself); a .rb file
#            with no existing convention target falls back to a word-boundary
#            grep of its class name across test/**/*_test.rb.
#   spine  : config/fast_cert_spine.yml — the always-run critical core (~10-20s),
#            so a diff that maps to nothing still exercises the money paths.
#            Mapped files already covered by a spine entry run only once.
#            The list is anchored in the HUB and filtered to paths that exist
#            under the code root, so a SATELLITE checkout (turf-monster, rolio)
#            resolves NONE of it — there, the mapped lane is the only lane that
#            can run a test, which is why the zero-evidence guard exists.
#   rubocop: the changed files rubocop can lint (never the whole repo).
#
# Lanes run from the repo root (the agent's worktree via RepoRoot, so a satellite
# task certifies the satellite). When a task slug is given and the root resolved
# implicitly from the cwd, the task-root guard (bin/lib/cert_root_guard.rb) first
# verifies that root IS the task's tree — its branch or its .worktrees dir — and
# REFUSES otherwise, so a run from the wrong checkout can't green-certify an
# unrelated tree. An explicit FAST_CHECK_ROOT bypasses the guard (deliberate root):
#   test-prepare    : bin/rails db:test:prepare test:prepare  (abort on red — no
#                     polluted cert). BOTH tasks, in one boot: the test DB, and Rails'
#                     test:prepare hook, which is what builds the gitignored
#                     app/assets/builds/tailwind.css. The lanes below pass explicit test
#                     PATHS, and Rails skips its own test:prepare whenever an argument
#                     looks like a path — so on a virgin worktree nothing would ever
#                     build the CSS and every view-rendering test would error with `The
#                     asset "tailwind.css" is not present in the asset pipeline`. (An
#                     ARGLESS `bin/rails test` — CI, bin/full-suite-check — fires the hook
#                     for free, which is why THIS lane was the first to break. The release
#                     gate workspaces were the other path-arg victim; fixed by
#                     gate-workspace-skips-test-prepare (PR #522): prepare_gate_workspace!
#                     now runs db:test:prepare test:prepare itself, whatever shape the
#                     registered command takes. See docs/agents/modules/testing.md.)
#   mapped-tests    : bin/rails test <mapped files>      (skipped when none map)
#   spine           : bin/rails test <spine entries>
#   rubocop-changed : bin/rubocop <changed lintable files> (skipped when none)
# All lanes green → ONE evidence line is recorded on the task's checks_run:
#   [fast-cert@<fp>] <summary of what ran>
# The write is PURE EVIDENCE — this cert sends ONLY the line it owns, never a
# snapshot of the author's lines. The write funnel (bin/task's build_devops +
# Task#preserve_cert_evidence, rule in lib/cert_evidence.rb) merges it against
# the board's CURRENT checks_run at write time: tier tags, bypass records, and
# the other lanes' evidence are carried forward, and only a PRIOR fast-cert line
# is superseded. This cert USED to resend a read-then-merged list instead, which
# let a snapshot read before the lanes ran overwrite a tier line the builder had
# recorded during the run — see the write block near the end of this file.
# After the write the board is READ BACK and BOTH the recorded [fast-cert@<fp>]
# evidence line AND every pre-existing line are checked present — so "recorded"
# and "preserved" are verified claims, not declarations. A read-back that finds
# the evidence line gone fails the cert (re-run it); a lost pre-existing line
# fails it too (re-record).
# A red lane records nothing and exits non-zero.
#
# G1 gate-run markers mirror bin/full-suite-check's: OPEN the task's g1_cert
# attempt at start, append one executed-SOP entry per lane, CLOSE it --success on
# the green path and --failed the moment the cert goes red. Cert OWNS the whole
# g1_cert window now — dor-check no longer touches g1_cert (its DoR verdict is the
# separate dor/dor_review gates). All emits are fire-and-forget (a board blip
# never breaks a cert) and are SKIPPED under --print (a dry run must not write to
# the durable record).
#
# Usage:
#   bin/fast-check <task-slug>            # run all lanes; record evidence on the task
#   bin/fast-check <task-slug> --print    # run + print the evidence line, don't record
#   bin/fast-check --print                # standalone (no task), just print
#   bin/fast-check [<task-slug>] --list   # print the selected test files and exit (no run)
#
# Test/CI seams (so the orchestration is exercisable without a real Rails run):
#   FAST_CHECK_CHANGED_FILES       inject the changed-file list (newline/comma
#                                  separated; empty string = no diff)
#   FAST_CHECK_DIFF_BASE           committed-diff base (default: origin/release
#                                  when present, else origin/main)
#   FAST_CHECK_ROOT                repo dir to run + fingerprint in (default: the
#                                  cwd's git toplevel, else this repo)
#   FAST_CHECK_SPINE               spine config path (default: config/fast_cert_spine.yml)
#   FAST_CHECK_MAPPED_CAP          max mapped test files before the lane is skipped
#                                  (default: 15, counted AFTER the spine dedupe)
#   FAST_CHECK_TEST_PREPARE_CMD    override the test-prepare lane — test DB + bundled
#                                  assets (default: bin/rails db:test:prepare test:prepare)
#   FAST_CHECK_SKIP_TEST_PREPARE   set to 1 only for non-Rails harness tests
#   FAST_CHECK_TEST_CMD            test runner prefix (default: bin/rails test)
#   FAST_CHECK_RUBOCOP_CMD         rubocop prefix (default: bin/rubocop)
#   FAST_CHECK_LANE_TIMEOUT        per-lane ceiling in seconds (default: 900). Past it the
#                                  lane is reported as a HUNG RUNNER, never as a red suite.
#   FAST_CHECK_TASK_BIN            board CLI (default: bin/task; tests stub it)
#   FAST_CHECK_GATE_BIN            gate CLI (default: bin/gate; tests stub it)
#
# Exit code: 0 = all lanes green (evidence recorded/printed), 1 = a lane failed,
# no fingerprint, the evidence couldn't be recorded, or the diff maps to NO test
# file at all (the zero-evidence guard below), 2 = DEFERRED to GitHub CI — the
# mapped lane was CAPPED over an empty spine, so no local lane could certify this
# tree and a fingerprint-bound receipt was recorded instead. 2 is NOT a
# certification: it is falsy to every `system(...)` caller, and only bin/ship
# reads it as "carry on to the PR" (bin/dor-check then requires a GREEN CI).

require "optparse"
require "json"
require "shellwords"
require_relative "lib/full_suite_gate"
require_relative "lib/repo_root"
require_relative "lib/fast_cert"
require_relative "lib/cert_emission"
require_relative "lib/cert_root_guard"
require_relative "lib/desk_guard"
require_relative "lib/cert_tree_guard"
require_relative "lib/cert_orphan_guard"
require_relative "lib/cert_process"

# ROOT = this script's OWN repo (the hub): CONFIG (the spine) and the board CLIs
# anchor here. The CODE we run + fingerprint roots at the agent's worktree.
ROOT = File.expand_path("..", __dir__)
TASK_BIN = ENV.fetch("FAST_CHECK_TASK_BIN", File.expand_path("task", __dir__))
GATE_BIN = ENV.fetch("FAST_CHECK_GATE_BIN", File.expand_path("gate", __dir__))
SPINE_CONFIG = ENV.fetch("FAST_CHECK_SPINE", File.join(ROOT, "config", "fast_cert_spine.yml"))

options = { print: false, list: false }
OptionParser.new do |o|
  o.banner = "Usage: bin/fast-check <task-slug> [--print] [--list]"
  o.on("--print", "Print the evidence line instead of recording it on the task") { options[:print] = true }
  o.on("--list", "Print the selected test files (mapped + spine) and exit without running") { options[:list] = true }
  o.on("-h", "--help", "Show this help") do
    puts o
    exit 0
  end
end.parse!

slug = ARGV.shift
root = RepoRoot.code_root(ENV["FAST_CHECK_ROOT"], ROOT)

# --- selection ---------------------------------------------------------------

changed =
  if ENV.key?("FAST_CHECK_CHANGED_FILES")
    ENV["FAST_CHECK_CHANGED_FILES"].to_s.split(/[\n,]/).map(&:strip).reject(&:empty?)
  else
    base = ENV.fetch("FAST_CHECK_DIFF_BASE") { FastCert.default_diff_base(root) }
    FastCert.changed_files(root, base)
  end

breakdown = FastCert.mapping(root, changed)
mapped = breakdown.values.flatten.uniq.sort
spine = FastCert.spine(root, SPINE_CONFIG)
mapped_only = mapped.reject { |t| FastCert.covered_by_spine?(t, spine) }
lintable = FastCert.lintable_files(root, changed)

# THE CAP, decided before anything runs so --list reports the same lane the run
# would execute. See FastCert.cap_decision for why it sits after the spine dedupe
# and why the default is as low as it is.
cap = FastCert.cap_decision(mapped_only, breakdown)

if options[:list]
  warn "fast-check: #{changed.size} changed file(s) → #{mapped.size} mapped test path(s), " \
       "#{spine.size} spine entr#{spine.size == 1 ? 'y' : 'ies'}, #{lintable.size} lintable file(s)"
  warn "fast-check: mapped cap #{cap[:cap]} — #{cap[:capped] ? 'EXCEEDED' : 'not reached'} " \
       "(#{cap[:count]} after the spine dedupe)"
  mapped_only.each { |t| puts(cap[:capped] ? "capped  #{t}" : "mapped  #{t}") }
  spine.each { |t| puts "spine   #{t}" }
  lintable.each { |f| puts "lint    #{f}" }
  exit 0
end

# --- task-root guard -----------------------------------------------------------
# The evidence stamps `root`'s fingerprint against the TASK — so when a slug is
# given and the root was resolved IMPLICITLY (cwd, no FAST_CHECK_ROOT), the root
# must BE the task's tree (its branch, or its .worktrees/<worktree_slug> dir).
# Run from the wrong checkout — the hub primary on main, say — this used to
# green-certify a tree the task never touched (fail-GREEN, live 2026-07-12).
# Refuse BEFORE any lane runs or gate/checkpoint write. bin/lib/cert_root_guard.rb.
if slug && ENV["FAST_CHECK_ROOT"].to_s.strip.empty?
  wrong_root = CertRootGuard.refusal(task_bin: TASK_BIN, slug: slug, root: root)
  abort "fast-check: #{wrong_root}" if wrong_root
end

# --- desk guard ----------------------------------------------------------------
# Right root, but is it a WHOLE desk? A worktree with no isolated test DB runs its
# suite against the SHARED base test database (config/database.yml falls back there
# when TEST_DATABASE_URL is blank) — so it would pollute, and be polluted by, every
# concurrent suite, and certify against a database that is not its own. Refuse before
# any lane or gate write, and name it as the ENV issue it is. bin/lib/desk_guard.rb.
half_built = DeskGuard.refusal(root)
abort "fast-check: #{half_built}" if half_built

# --- dirty-tree guard ----------------------------------------------------------
# Same family as the root guard above, same fail-GREEN shape: the root guard stops
# a cert of the wrong TREE, this one stops a cert of an UNCOMMITTED tree. The
# fingerprint hashes the WORKING tree (git add -A + write-tree), so certifying with
# edits still uncommitted stamps GREEN evidence over code the PR never receives —
# live on 2026-07-14, when a worktree's 146 lines of certified work never reached
# PR #537. Certify AFTER the final commit; this makes that a rule, not a memory.
# Same gating as the root guard: only with a slug (no slug → --print/hook, nothing
# is recorded, nothing to protect) and only on an IMPLICIT root (an explicit
# FAST_CHECK_ROOT is the deliberate CI/test seam). The index is refreshed before it
# is read, so a stat-stale tree cannot false-refuse. bin/lib/cert_tree_guard.rb.
if slug && ENV["FAST_CHECK_ROOT"].to_s.strip.empty?
  dirty = CertTreeGuard.refusal(command: "bin/fast-check", root: root)
  abort "fast-check: #{dirty}" if dirty
end

# --- lane plumbing (mirrors bin/full-suite-check) ------------------------------

# WHICH REPO THIS CHECKOUT IS. Resolved from `root` — the tree itself — and hoisted
# here because every lane decision below depends on it: which test command to run,
# whether a test DB exists to prepare, and whether a lint lane is owed at all. It was
# already resolved at the bottom of this script for the evidence line; a gem repo
# proved that was far too late.
cert_repo = CertRootGuard.repo_of_checkout(root)

# A GEM REPO HAS NO bin/rails AND NO bin/rubocop. studio-engine is the case: the
# defaults below are Rails-app assumptions, and against a gem all three lanes died on
# an unrescued Errno::ENOENT before this script reached a single test. That is why
# `bin/full-suite-check` learned to read the registry (release_check + the gems
# section); this is the same fix on the path builders ACTUALLY run.
#
# THERE IS NO DIFF-MAPPED SHORTCUT FOR A GEM, and pretending otherwise would be the
# dishonest version of this fix. fast-check's speed comes from mapping a diff onto a
# subset of a Rails suite; a gem's registry command is its whole gate. So a gem repo
# runs that gate, and the narration SAYS it is running the full thing rather than
# implying a subset was chosen. It is fast enough to be the builder default:
# studio-engine's bin/release-check covers 100 files / 1456 runs.
registry_test_cmd = FullSuiteGate.release_check_cmd(cert_repo)
gem_repo = FullSuiteGate.gem_repo?(cert_repo)

# NO LINT-WAIVER BRANCH HERE, deliberately. bin/full-suite-check needs one because it
# runs a rubocop lane for every repo; this script does not reach that question for
# EITHER repo that declares `lint_lane: none`. studio-engine and solana-studio (added
# 2026-08-31) are both GEMS, and the gem branch below omits the rubocop lane before a
# waiver could be consulted — so a waiver check on this path would be code no repo can
# currently execute.
#
# It was written, and removed after a mutation proved the point: flipping
# FullSuiteGate.lint_waived? to false changed nothing observable, because the gem
# branch had already decided. If a NON-gem repo ever declares lint_lane: none, add the
# branch then, with a test that can actually redden. (The set of declaring repos is
# asserted in test/lib/cert_lint_lane_waiver_test.rb, so growing it past the gems
# section reddens there rather than silently invalidating this paragraph.)

test_cmd = ENV.fetch("FAST_CHECK_TEST_CMD") { registry_test_cmd || "bin/rails test" }
rubocop_cmd = ENV.fetch("FAST_CHECK_RUBOCOP_CMD", "bin/rubocop")
# The prepare lane is db:test:prepare AND test:prepare, in one boot. test:prepare is
# Rails' standard pre-test hook, which tailwindcss-rails enhances with tailwindcss:build
# (cssbundling/jsbundling enhance it the same way) — it is what BUILDS the gitignored
# app/assets/builds/tailwind.css. An ARGLESS `bin/rails test` runs that hook itself, which
# is why CI and bin/full-suite-check are green on a virgin tree (the release gate
# workspaces prep their own env the same way since gate-workspace-skips-test-prepare,
# PR #522; see docs/agents/modules/testing.md) — but THIS cert's lanes pass explicit test paths, and
# Rails::Command::TestCommand
# runs the hook only `if self.args.none?(EXACT_TEST_ARGUMENT_PATTERN)`, so a path argument
# SKIPS it. db:test:prepare alone does not build the CSS either (tailwindcss enhances it
# only as a fallback, when test:prepare is undefined — it never is). Without this, every
# view-rendering test in a fresh worktree errored `The asset "tailwind.css" is not present
# in the asset pipeline`: a RED G1 cert on a docs-only or ci.yml-only diff. A cert that
# reports an ENV GAP as a test regression is lying — so the cert closes the gap itself.
test_prepare_cmd = ENV.fetch("FAST_CHECK_TEST_PREPARE_CMD", "bin/rails db:test:prepare test:prepare")
# A gem has no test database and no bin/rails to prepare one with, so this lane does
# not APPLY to it — it is not "skipped" in the opt-out sense. Declared from the
# registry's gems section, never inferred from whether bin/rails happens to exist.
skip_test_prepare = ENV.fetch("FAST_CHECK_SKIP_TEST_PREPARE", "") == "1" || gem_repo

# --- the zero-evidence guard ---------------------------------------------------
# A CERT THAT EXECUTES NO TESTS MUST NOT REPORT GREEN. The cap can skip the mapped
# lane and the spine can resolve to nothing in the same run — on turf-monster PR
# #549 it did, and this script printed "fast cert green" over a run whose only
# executed lane was rubocop. That still never certifies.
#
# WHAT CHANGED IS WHERE THE EVIDENCE COMES FROM, not whether it is demanded. The
# guard now has two verdicts (FastCert.zero_test_outcome): a diff that maps to NO
# test REFUSES exactly as before, while a CAPPED diff — which mapped to MORE tests
# than the cap, every one of which runs on CI — DEFERS: it records a
# fingerprint-bound "[cert-deferred@<fp>]" receipt and exits 2, so ship can push
# and open the PR and bin/dor-check can demand the GREEN CI at step 7. The refusal
# moved from step 2 of 8 (no PR, no CI, ~30 minutes of local suite as the only
# remedy) to step 7 (the PR open, CI settled, the verdict on real evidence).
#
# DECIDED HERE, BEFORE ANY LANE, because it is a precondition on the SELECTION —
# the same shape as the root, desk, and dirty-tree guards above, which all abort
# before the g1_cert attempt is opened. Nothing is recorded and no attempt is
# stamped: a G1 attempt that ran no lane would report a testing window measuring
# nothing. Deciding it first also costs the builder ~0s instead of a
# db:test:prepare they are going to have to redo under another command anyway.
#
# NOT FOR A GEM. A gem's registry command IS its suite and runs as the mapped
# lane, so a gem never has an empty mapped lane to refuse — reading `mapped_only`
# for one would refuse the repo that runs the MOST.
unless gem_repo
  zero = FastCert.zero_test_outcome(mapped_only, spine, cap, slug: slug)
  abort "fast-check: #{zero[:message]}" if zero && zero[:kind] == :refuse

  if zero && zero[:kind] == :defer
    # THE DEFERRAL, and the reason it is decided HERE rather than in bin/ship: this is the
    # only place that knows WHY no lane will run, and the receipt has to be bound to the
    # tree that fact is true of. Ship owns the POLICY (carry on to the PR); this owns the
    # DETECTION and the RECORD. See FastCert.zero_test_outcome for the case split.
    warn "fast-check: #{zero[:message]}"

    defer_fp = FullSuiteGate.fingerprint(root)
    if defer_fp.nil?
      # No fingerprint, no receipt — and a receipt is the ONLY thing that makes a deferral
      # different from a shrug. Refuse rather than defer into nothing.
      abort "fast-check: could not fingerprint the code at #{root} (no git repo / identity?), so the " \
            "deferral cannot be recorded and dor-check would refuse it. Certify locally instead: " \
            "bin/full-suite-check #{slug || '<task>'}"
    end

    defer_line = FullSuiteGate.evidence_line(FullSuiteGate::DEFER_LANE, defer_fp, zero[:detail],
                                             repo: cert_repo)
    puts defer_line

    if options[:print] || slug.nil?
      warn "fast-check: DEFERRED at #{defer_fp[0, 12]}." \
           "#{slug.nil? ? ' (no task slug — receipt printed, not recorded)' : ' (--print: not recorded)'}"
      exit FastCert::DEFERRED_EXIT
    end

    # RECORD IT OR REFUSE. An unrecorded deferral is strictly worse than a refusal: ship
    # would push, open the PR, wait out the CI, and dor-check would then refuse for want of
    # the receipt — the same 30 minutes back, spent later and less legibly. Same
    # baseline-then-read-back discipline the green path uses, for the same reason: a write
    # this gate cannot VERIFY is a write it must not rely on.
    defer_existing = CertEmission.fetch_checks(TASK_BIN, slug)
    if defer_existing.nil?
      abort "fast-check: DEFERRED, but #{slug.inspect}'s checks_run could not be read (bin/task show), so " \
            "the receipt cannot be written or verified. Re-run bin/fast-check #{slug}."
    end
    unless system(TASK_BIN, "update", slug, "--checks", defer_line)
      abort "fast-check: DEFERRED, but FAILED to record the receipt on #{slug.inspect} (bin/task update). " \
            "Re-run bin/fast-check #{slug}."
    end
    defer_kept = defer_existing.reject { |prior| prior.match?(FullSuiteGate.evidence_re([FullSuiteGate::DEFER_LANE])) }
    defer_missing = CertEmission.missing_after_write(TASK_BIN, slug, [defer_line] + defer_kept)
    if defer_missing.nil?
      # The write returned 200; only the confirming READ failed. Say so — the deferral IS
      # recorded as far as anything here can tell, and dor-check reads the board itself.
      warn "fast-check: DEFERRED at #{defer_fp[0, 12]} — receipt written to #{slug}, but the read-back " \
           "FAILED (UNVERIFIED). Check with bin/task show #{slug} -v; if it is absent, re-run bin/fast-check #{slug}."
    elsif defer_missing.any?
      abort "fast-check: DEFERRED, but the read-back is MISSING #{defer_missing.size} checks line(s) — the " \
            "receipt did not land, and dor-check will refuse without it:\n  #{defer_missing.join("\n  ")}\n" \
            "Re-run bin/fast-check #{slug}."
    else
      warn "fast-check: DEFERRED at #{defer_fp[0, 12]} — receipt recorded on #{slug} (read-back confirms). " \
           "GitHub CI is now the ONLY evidence for this diff, and dor-check requires it GREEN."
    end
    exit FastCert::DEFERRED_EXIT
  end
end

# --- the lane ceiling -----------------------------------------------------------
# NO LANE MAY RUN FOREVER. Measured 2026-08-21: a turf-monster mapped-tests lane sat
# 41 minutes at 0.0% CPU (its forked test workers had SIGSEGVed at the fork and the
# runner was parked on the DRb channel waiting for them), and this cert then printed
# "lane(s) RED: mapped-tests". That verdict is a LIE about the cause — no test ever
# ran — and every agent who read it retried into the same wall, burning a whole
# harness budget per attempt. The ceiling is the fix; naming the RUNNER instead of
# the tests is the point of it.
#
# CALIBRATED ON THE SLOW SIDE, deliberately, because this box is not the CI box.
# MEASURED normal case for a fast-check lane: the cert's own header budgets ~1 MINUTE
# for ALL lanes together; the widest single lane observed is the spine at ~10-20s, and
# a full turf-monster suite — far more than any fast lane runs — takes 93s serially
# (2423 runs, measured 2026-08-22 on this hardware). 900s is therefore ~10x the
# slowest legitimate lane and ~15x the whole cert: a lane that reaches it is not slow,
# it is stuck. Retune with the measurement in hand, and update this paragraph when you
# do — a ceiling with no recorded normal case is a number nobody can safely change.
LANE_TIMEOUT = Integer(ENV.fetch("FAST_CHECK_LANE_TIMEOUT", "900"), exception: false) || 900

# Best-effort G1 gate-run markers + cert checkpoint + checks_run read: shared
# with bin/full-suite-check (CertEmission), parameterized on this script's
# TASK_BIN/GATE_BIN seams. Skipped when there's no task slug (--print).
def emit_gate(slug, *args)
  CertEmission.emit_gate(GATE_BIN, slug, *args)
end

def emit_cert_checkpoint(slug, status)
  CertEmission.emit_cert_checkpoint(TASK_BIN, slug, status)
end

# The lane runs in its OWN process group (CertProcess), so a signal aimed at this
# cert reaps the SUITE too. A bare `system` left `bin/rails test` running with PPID
# 1 when the harness's 120s timeout killed the cert — holding the worktree test DB
# and failing every retry with PG::ObjectInUse. See bin/lib/cert_process.rb.
# Returns a CertProcess::Result, not a bare boolean, so a TIMEOUT can be told apart
# from a red suite downstream. `.ok` is false either way — a hung lane can never
# certify, whatever the caller forgets to check.
def run_lane(label, cmd, root, env: {}, gate_slug: nil, timeout: LANE_TIMEOUT)
  warn "== #{label}: #{cmd} =="
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  # Announce the lane BEFORE it runs, then beat while it runs, so the board can
  # name what a building task is inside and tell a live cert from a killed one.
  # The beat is stopped in the ensure below, ORDERED against the terminal row: a
  # leaked beat would keep a dead cert looking alive, and a beat still in flight
  # when the verdict lands would repaint `running` OVER it.
  CertEmission.emit_gate_sop_running(GATE_BIN, gate_slug, label, cmd) if gate_slug
  beat = (CertEmission.heartbeat_thread(GATE_BIN, gate_slug, label, cmd) if gate_slug)
  # What a CATCHABLE death owes the board. CertProcess reaps the suite and then
  # `exit!`s — which skips every ensure below, this cert's gate close included —
  # so the closure IS the close on that path. It runs inside a trap handler:
  # stop_now, never stop, because Mutex#synchronize raises in trap context.
  on_signal = (lambda do |sig|
    beat&.stop_now
    CertEmission.emit_interrupt_close(
      GATE_BIN, gate_slug, label, cmd, sig,
      ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
    )
  end if gate_slug)
  begin
    result = CertProcess.run_bounded(env, cmd, chdir: root, root: root, lane: label,
                                     timeout: timeout, on_signal: on_signal)
  ensure
    CertEmission.stop_heartbeat(beat)
  end
  duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
  elapsed = format("%.1fs", duration_ms / 1000.0)
  if result.timeout?
    warn "   #{label}: TIMED OUT after #{elapsed} — the RUNNER never produced a verdict"
  elsif result.unlaunchable?
    # NOT a verdict on the diff: nothing ran. bin/full-suite-check already words this
    # correctly and this script did not — so the path builders ACTUALLY run reported a
    # missing command as "FAIL", sending them to hunt a bug in code that never
    # executed. Reachable for real now that a registry row can name a gate command a
    # given checkout does not carry.
    warn "   #{label}: COULD NOT RUN — #{result.detail}"
    warn "   Nothing was certified by this lane. The command is the problem, not your diff."
  else
    warn(result.ok ? "   #{label}: PASS (#{elapsed})" : "   #{label}: FAIL")
  end
  CertEmission.emit_gate_sop(GATE_BIN, gate_slug, label, cmd, result.ok, duration_ms) if gate_slug
  result
end

# A lane with nothing to run passes vacuously — recorded on G1 as a pass with a
# "nothing to run" cmd so the attempt shows the lane was CONSIDERED, not lost.
def skip_lane(label, why, gate_slug: nil)
  warn "== #{label}: skipped (#{why}) =="
  CertEmission.emit_gate_sop(GATE_BIN, gate_slug, label, "skipped: #{why}", true, 0) if gate_slug
  CertProcess::Result.new(ok: true, outcome: :skipped)
end


# --- orphan guard ----------------------------------------------------------------
# A cert that outran its harness timeout leaves a `bin/rails test` orphan holding the
# worktree test DB; the retry then dies in test-prepare with PG::ObjectInUse and
# blames "an ENV gap", so the agent retries into the same wall (live 2026-07-13:
# three attempts, 35 minutes, zero progress). Prevention (the process-group reap
# above) cannot cover a SIGKILL, so before ANY lane runs we read the runlock a
# previous cert left: reap what is provably our own orphan, REFUSE a live concurrent
# cert or a test DB somebody else is holding, and NAME whatever we find. Fail closed
# and loud beats a blind retry. bin/lib/cert_orphan_guard.rb.
unless ENV["FAST_CHECK_SKIP_ORPHAN_GUARD"] == "1"
  verdict, payload = CertOrphanGuard.preflight(root: root)
  abort "fast-check: #{payload}" if verdict == :refuse

  Array(payload).each { |notice| warn "fast-check: #{notice}" }
end

# --- run ------------------------------------------------------------------------

overall_started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
gate_slug = options[:print] ? nil : slug
emit_cert_checkpoint(slug, "started") unless options[:print]
emit_gate(gate_slug, "open", "task", gate_slug.to_s, "g1_cert") if gate_slug

# THE ATTEMPT MUST NOT SURVIVE THIS PROCESS. Every deliberate exit below closes the
# g1_cert attempt; an UNRESCUED exception closed nothing and left it OPEN.
#
# WHAT THAT ACTUALLY COSTS — the first version of this comment overstated it, claiming
# no later run cleans the attempt up. GateRun.open! (app/models/gate_run.rb:96-105)
# RETURNS an existing in-flight attempt rather than creating a second, so the next
# cert adopts and closes it. The real damage is subtler: stamp_g1_testing_window fires
# on CREATE only, so the adopted attempt keeps its original started_at and reports an
# inflated duration — and until that next cert runs, the card reads STALLED.
#
# THE FLAG IS SET BEFORE EACH CLOSE, NOT AFTER, and the ordering is load-bearing.
# emit_gate shells out to bin/gate, and the tail of a cert is exactly when an operator
# reaches for Ctrl-C. With the flag set afterwards, a SIGINT arriving while that
# subprocess ran raised Interrupt with the flag still false, so this block fired a
# SECOND close — and that close is NOT idempotent: GateRun.close! finds no in-flight
# attempt, calls open!, creates attempt n+1, and latest_by_key takes the last. A
# spurious --failed row then becomes the G1 verdict over a cert that PASSED. The
# window is the whole duration of the closing subprocess, and it sits outside every
# lane, so CertProcess installs no trap across it.
#
# Nothing is lost by setting the flag first: emit_gate is already fire-and-forget and
# rescues StandardError, so if the gate CLI were down, the at_exit retry would only
# reach the same down CLI.
#
# KNOWN LIMIT, stated rather than papered over: CertProcess reaps a runaway suite with
# `exit!`, which skips at_exit entirely. That path is covered by run_lane's on_signal
# handler instead, and this backstop cannot help there.
g1_settled = false
at_exit do
  next if g1_settled || gate_slug.nil?

  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed")
  warn "fast-check: closed an unsettled g1_cert attempt on the way out " \
       "(the run died before reaching a verdict)"
end

unless skip_test_prepare
  prepare_res = run_lane("test-prepare", test_prepare_cmd, root, env: { "RAILS_ENV" => "test" },
                         gate_slug: gate_slug)
  if prepare_res.timeout?
    # A wedged db:test:prepare is the same disease one lane earlier, and the stock
    # message below would misfile it as "an ENV gap you can fix" — it is a hung runner.
    CertProcess.timeout_report({ "test-prepare" => prepare_res }, ceiling: LANE_TIMEOUT,
                               tool: "fast-check", env_var: "FAST_CHECK_LANE_TIMEOUT").each { |l| warn l }
      g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
    exit 1
  end
  unless prepare_res.ok
    if prepare_res.unlaunchable?
      # A COMMAND THAT IS NOT THERE IS NOT AN ENV GAP, and the sentence below is
      # the wrong errand for it. Measured 2026-08-29 shipping a turf-vault task:
      # the repo is Anchor/Rust and has no bin/rails, so this lane could not
      # launch, and the reader was told to go fix a test database that this repo
      # will never have. "Fix it and re-run" is advice with no fix behind it.
      #
      # REFUSING, NOT SKIPPING, and that is the deliberate half. Skipping the
      # prepare lane for any repo that happens to lack bin/rails would hand back
      # a GREEN cert for a repo whose tests never ran — silently certifying the
      # untested, which is worse than refusing to certify at all. A repo whose
      # cert lane is not Rails has to DECLARE one, the way a gem declares its
      # test lane in config/release_repos.yml; what that lane should BE for an
      # Anchor repo is a real design question and it is not this script's to
      # answer. /tasks/turf-vault-needs-ci owns it.
      warn "fast-check: the test-env prepare command COULD NOT RUN — #{prepare_res.detail}. " \
           "NOTHING was certified, and this is NOT a diff problem and NOT an env gap you can fix: " \
           "this checkout (#{root}) has no such runner, so there was never a test database to prepare. " \
           "If this repo's cert lane is not Rails, it has to DECLARE one in config/release_repos.yml the " \
           "way a gem declares its test lane — see /tasks/turf-vault-needs-ci, which owns that decision. " \
           "Refusing rather than skipping: a skipped prepare lane certifies a repo whose tests never ran."
    else
      warn "fast-check: test-env prepare failed — see the output above. USUALLY an ENV gap (the test " \
           "DB, or the bundled-asset build), NOT a regression in your diff; but a broken stylesheet " \
           "IN your diff (a bad @apply, an unknown utility, a malformed @theme) fails this lane too. " \
           "Nothing certified; fix it and re-run."
    end
      g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
    exit 1
  end
end

# A GEM RUNS ITS WHOLE GATE AS THE "MAPPED" LANE. There is no diff-mapped subset to
# choose — the registry command IS the suite — so the lane label stays honest by
# naming the command, and the spine lane below is left to skip itself (a gem has no
# spine entries). Anything else would report a subset that was never selected.
if gem_repo
  mapped_res = run_lane("gem-gate", test_cmd, root, gate_slug: gate_slug)
  spine_res  = skip_lane("spine", "gem repo — its registry gate above is the whole suite",
                         gate_slug: gate_slug)
  rubocop_res = nil
else
mapped_res =
  if mapped_only.empty?
    skip_lane("mapped-tests", mapped.empty? ? "no tests map from the diff" : "all mapped tests covered by the spine",
              gate_slug: gate_slug)
  elsif cap[:capped]
    # LOUD, because a silently-skipped lane is how a cert stops meaning anything.
    # The builder is told the cap, what tripped it, and the one command that DOES
    # cover a diff this broad — the spine still runs below, so this is a narrower
    # cert rather than no cert.
    warn ""
    warn "fast-check: MAPPED LANE CAPPED — #{cap[:count]} mapped test file(s) exceeds the cap of #{cap[:cap]}."
    if cap[:worst_path]
      warn "  widest mapping: #{cap[:worst_path]} → #{cap[:worst_count]} test file(s)"
      warn "  a file with no convention target falls back to a word-boundary grep of its"
      warn "  camelized name; when that matches this much of the suite it is telling you the"
      warn "  token is generic, not which tests are relevant."
    end
    warn "  running the SPINE ONLY. For a diff this broad the right cert is:"
    warn "    bin/full-suite-check #{gate_slug || '<task>'}"
    warn "  (override deliberately with FAST_CHECK_MAPPED_CAP=<n>.)"
    warn ""
    skip_lane("mapped-tests",
              "#{cap[:count]} mapped file(s) over the cap of #{cap[:cap]}" \
              "#{cap[:worst_path] ? " (widest: #{cap[:worst_path]} → #{cap[:worst_count]})" : ''}" \
              " — spine only; use bin/full-suite-check for this diff",
              gate_slug: gate_slug)
  else
    run_lane("mapped-tests", "#{test_cmd} #{mapped_only.map(&:shellescape).join(' ')}", root, gate_slug: gate_slug)
  end

spine_res =
  if spine.empty?
    skip_lane("spine", "no spine entries exist in this checkout", gate_slug: gate_slug)
  else
    run_lane("spine", "#{test_cmd} #{spine.map(&:shellescape).join(' ')}", root, gate_slug: gate_slug)
  end

rubocop_res =
  if lintable.empty?
    skip_lane("rubocop-changed", "no lintable files in the diff", gate_slug: gate_slug)
  else
    run_lane("rubocop-changed", "#{rubocop_cmd} #{lintable.map(&:shellescape).join(' ')}", root, gate_slug: gate_slug)
  end
end

emit_cert_checkpoint(slug, "completed") unless options[:print]

total = Process.clock_gettime(Process::CLOCK_MONOTONIC) - overall_started

lanes = { (gem_repo ? "gem-gate" : "mapped-tests") => mapped_res, "spine" => spine_res }
lanes["rubocop-changed"] = rubocop_res if rubocop_res
unless lanes.each_value.all?(&:ok)
  # A HUNG lane and a RED lane are DIFFERENT VERDICTS and must never share a sentence.
  # "lane(s) RED" tells the reader their tests failed; when the runner deadlocked, no
  # test ran and that sentence sends them straight back into the wall. Split them here,
  # report the hang FIRST (it is the one that needs a different action), and only call
  # the genuinely-red lanes red.
  hung = lanes.select { |_, result| result.timeout? }
  # THREE VERDICTS, NOT TWO. A lane whose COMMAND is absent is not a red lane any
  # more than a hung one is: no test ran, so "lane(s) RED" sends the reader to
  # hunt a regression in code that never executed. run_lane already words the
  # per-lane line correctly; this summary was the line that undid it.
  unlaunchable = lanes.select { |_, result| result.unlaunchable? }
  red = lanes.reject { |_, result| result.ok || result.timeout? || result.unlaunchable? }.keys

  if hung.any?
    CertProcess.timeout_report(hung, ceiling: LANE_TIMEOUT, tool: "fast-check",
                               env_var: "FAST_CHECK_LANE_TIMEOUT").each { |l| warn l }
  end
  if unlaunchable.any?
    unlaunchable.each do |label, result|
      warn "fast-check: lane(s) COULD NOT RUN: #{label} — #{result.detail}. The COMMAND is missing from " \
           "this checkout; your tests neither passed nor failed. Nothing certified."
    end
  end
  if red.any?
    warn "fast-check: lane(s) RED: #{red.join(', ')}. Fix, then re-run — nothing certified. " \
         "(#{format('%.1fs', total)})"
  end
    g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
  exit 1
end

# All lanes green. The g1_cert attempt is NOT closed --success here (dor-check no
# longer owns G1's close either): a green cert still has to RECORD and then VERIFY
# its evidence, and closing success before that would leave the gate reading
# success on a write/read-back failure that exits 1. The success close now lives
# at the very end, after the read-back confirms; every failure path below closes
# --failed on its way out.
fingerprint = FullSuiteGate.fingerprint(root)
if fingerprint.nil?
  warn "fast-check: could not fingerprint the code at #{root} (no git repo / identity?) — nothing certified."
    g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
  exit 1
end

# The mapped count is what RAN, not what mapped: a capped lane is SKIPPED, so
# mapped_only.size would record "41 mapped" for ZERO mapped tests actually run.
mapped_detail =
  if cap[:capped]
    "0 mapped (CAPPED: #{cap[:count]} mapped path(s) over the cap of #{cap[:cap]}; " \
      "spine only — bin/full-suite-check covers this diff)"
  else
    "#{mapped_only.size} mapped"
  end

# THE EVIDENCE MUST DESCRIBE WHAT ACTUALLY RAN. The app wording counts diff-mapped
# paths, which for a gem are all zero — so the first draft of this fix emitted
# "0 mapped + 0 spine test path(s), rubocop on 0 changed file(s)" after running the
# repo's ENTIRE gate. Every number was true and the sentence was false: it reads as a
# cert that tested nothing. A reader deciding whether to trust this line is exactly
# who that would mislead.
detail =
  if gem_repo
    "fast cert green: #{test_cmd} — the repo's whole registry gate, no diff-mapped " \
      "subset exists for a gem (#{format('%.1fs', total)}; the same command runs on CI)"
  else
    "fast cert green: #{mapped_detail} + #{spine.size} spine test path(s), " \
      "rubocop on #{lintable.size} changed file(s) " \
      "(#{format('%.1fs', total)}; full suite runs on CI)"
  end
line = FullSuiteGate.evidence_line(FullSuiteGate::FAST_LANE, fingerprint, detail,
                                   repo: cert_repo)

# Print the evidence line on stdout (parseable; the narration is on stderr).
puts line

if options[:print] || slug.nil?
  warn "fast-check: all lanes green at #{fingerprint[0, 12]} in #{format('%.1fs', total)}." \
       "#{slug.nil? ? " (no task slug — evidence printed, not recorded)" : " (--print: not recorded)"}"
  exit 0
end

# Read the current checks_run — the BASELINE the read-back below verifies against.
# If it can't be read, ABORT rather than certify blind: an unverifiable write is
# exactly the failure this gate exists to catch.
existing = CertEmission.fetch_checks(TASK_BIN, slug)
if existing.nil?
  warn "fast-check: ran green but couldn't read #{slug.inspect}'s checks_run (bin/task show), so the write " \
       "cannot be verified. Not writing. Re-run, or record by hand: bin/task update #{slug} " \
       "--checks #{Shellwords.escape(line)}"
    g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
  exit 1
end

# Record the evidence as a PURE-EVIDENCE write: ONLY the line this cert owns.
# The cert must NOT resend its snapshot of the author's lines — that is an author
# write, and it replaces the author namespace with content read BEFORE the lanes
# ran, silently clobbering any tier line the board gained since (a builder
# recording checks during a multi-minute cert, a concurrent writer). Sending just
# the evidence lets the write funnel (bin/task's build_devops + Task#preserve_
# cert_evidence, lib/cert_evidence.rb) merge against the board's CURRENT state at
# write time: the author namespace is carried forward, and this lane's prior line
# is superseded. No snapshot, no stale window.
record_args = ["--checks", line]
unless system(TASK_BIN, "update", slug, *record_args)
  warn "fast-check: ran green but FAILED to record evidence on #{slug.inspect} (bin/task update). Re-run."
    g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
  exit 1
end

# ── read-back: VERIFY the write. This block is kept BYTE-IDENTICAL with its twin
# in the sibling cert (bin/fast-check ⇄ bin/full-suite-check) down to the comments;
# only the script name, the recorded-evidence set, and the re-run command differ.
# "Recorded" and "preserved" are VERIFIED, never declared. Read the board back and
# check that BOTH the evidence line(s) this cert OWNS and every pre-existing line
# it must not disturb are present. Verifying only the pre-existing lines and
# trusting bin/task's 200 for the line(s) the cert is responsible for is the exact
# missing-signal-read-as-success defect this gate exists to catch, turned on the
# cert's own output. `kept` is every prior line except this cert's own lane(s),
# whose fresh evidence supersedes the old by design.
kept = existing.reject { |prior| prior.match?(FullSuiteGate.evidence_re([FullSuiteGate::FAST_LANE])) }
recorded = [line]
summary = "fast-check: all lanes green at #{fingerprint[0, 12]} in #{format('%.1fs', total)} — evidence " \
          "recorded on #{slug}"
# The GATE still accepts a pending CI provisionally — that is unchanged. But
# bin/ship now WAITS for CI before calling it (gate-submit-on-green-ci), so the
# ordinary handoff is credited against a settled green and the provisional path is
# the fallback, not the norm. Saying "no CI wait at submit" here sent the reader to
# the opposite expectation of what ship actually does.
followup = "dor-check accepts it provisionally on a pending CI, but bin/ship waits for CI to settle first " \
           "(SHIP_CI_WAIT=off disarms), so the usual handoff is credited green; review's " \
           "gate-zero enforces the settled CI green either way."

missing = CertEmission.missing_after_write(TASK_BIN, slug, recorded + kept)
if missing.nil?
  # The write returned 200 (bin/task update exited 0); only the confirming READ
  # did not complete. The certification happened — close success, exit 0.
  warn "#{summary}, but the read-back FAILED — UNVERIFIED that the recorded evidence" \
       "#{kept.empty? ? '' : " and the #{kept.size} pre-existing checks line(s)"} landed. " \
       "Verify: bin/task show #{slug} -v. #{followup}"
    g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--success") if gate_slug
  exit 0
end

lost_evidence = missing & recorded
lost_kept = missing - recorded
if lost_evidence.any? || lost_kept.any?
  warn "fast-check: green cert, but the read-back is MISSING #{missing.size} recorded checks line(s):"
  missing.each { |lost| warn "  #{lost}" }
  if lost_evidence.any?
    # The cert's OWN evidence line(s) did not land — re-running regenerates them.
    # Never hand-write a "[<lane>@<fp>]" line: that forges the certification.
    warn "fast-check: the evidence line did NOT land — re-run the cert: bin/fast-check #{slug}"
  end
  if lost_kept.any?
    # Re-record the UNION — survivors AND lost. `--checks` REPLACES the author
    # namespace, so a lost-lines-only command would itself drop the survivors
    # (round-2 catch). SHELL-quoted (Shellwords), not String#inspect: this command
    # is PASTED, and a Ruby literal leaves $(…)/backticks live in double quotes
    # (round-3 catch).
    warn "fast-check: re-record the full pre-existing set (survivors AND lost — resending only the lost " \
         "lines would drop the survivors): bin/task update #{slug} " \
         "#{kept.map { |line_kept| "--checks #{Shellwords.escape(line_kept)}" }.join(' ')}"
  end
    g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
  exit 1
end

  # Write CONFIRMED on the board — only NOW self-close the G1 attempt success.
  g1_settled = true
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--success") if gate_slug
warn "#{summary} (read-back confirms the evidence line landed" \
     "#{kept.empty? ? '; no pre-existing checks lines to preserve' : " and all #{kept.size} pre-existing checks line(s) kept"}). " \
     "#{followup}"
exit 0
